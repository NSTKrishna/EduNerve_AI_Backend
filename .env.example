# Copy to .env and fill in. Variables marked (required) stop the server from starting if missing.

PORT=3000
NODE_ENV=development

# (required) Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/edunerve

# (required) Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# AI feedback + interview prompt generation (required when NODE_ENV=production)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Voice interview (required when NODE_ENV=production). Only the public key is sent to browsers.
VAPI_PUBLIC_KEY=
VAPI_SECRET_KEY=
VAPI_MODEL=gpt-3.5-turbo
VAPI_VOICE_ID=paula

# Extra allowed browser origins, comma separated (localhost + the Vercel app are built in)
CORS_ORIGINS=

# Number of reverse proxies in front of the app (defaults to 1 in production)
# TRUST_PROXY=1
